# Copy this file to .env and fill in the values.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_laundry

# Web server (3003 so it can run next to the other projects on 3000-3002)
PORT=3003

# Any long random string. Used to sign login cookies.
SESSION_SECRET=change-me-to-a-long-random-string
